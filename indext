<main id="bookSections"></main>

<!-- مزايا الموقع -->
<section class="features">

    <div class="feature">
        <span class="material-icons-round">auto_stories</span>
        <div>
            <strong>مكتبة متنوعة</strong>
            <small>كتب في مختلف المجالات</small>
        </div>
