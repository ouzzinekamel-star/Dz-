        description: "موضوعات تمهيدية في عالم التقنية والحوسبة."
    },
    {
        title: "مبادئ القانون",
        author: "مؤلفون متنوعون",
        category: "قانونية",
        rating: "4.2",
        cover: "https://covers.openlibrary.org/b/isbn/9780198863155-L.jpg",
        description: "مقدمة عامة إلى مفاهيم قانونية أساسية."
    },
    {
        title: "تعلم اللغة",
        author: "مؤلفون متنوعون",
        category: "تعليمية",
        rating: "4.3",
        cover: "https://covers.openlibrary.org/b/isbn/9780194202411-L.jpg",
        description: "موضوعات تعليمية تساعد على اكتساب المعرفة."
    }
];

const sections = [
    { title: "كتب شائعة", category: "الكل", icon: "local_fire_department" },
    { title: "كتب دينية", category: "دينية", icon: "mosque" },
    { title: "كتب ثقافية", category: "ثقافية", icon: "account_balance" },
    { title: "روايات وقصص", category: "روايات وقصص", icon: "auto_stories" },
    { title: "كتب تعليمية", category: "تعليمية", icon: "school" },
    { title: "تطوير الذات", category: "تطوير الذات", icon: "trending_up" },
    { title: "كتب علمية", category: "علمية", icon: "science" },
    { title: "كتب قانونية", category: "قانونية", icon: "balance" },
    { title: "كتب تقنية", category: "تقنية", icon: "memory" }
];

const sectionsContainer = document.getElementById("bookSections");
const searchInput = document.getElementById("searchInput");
const bookModal = document.getElementById("bookModal");
const modalContent = document.getElementById("modalContent");

let activeCategory = "الكل";
let searchTerm = "";

function escapeHTML(value) {
    return String(value).replace(/[&<>"']/g, char => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
    })[char]);
}

function renderBooks() {
    sectionsContainer.innerHTML = "";

    const filteredBooks = books.filter(book => {
        const matchesCategory =
            activeCategory === "الكل" ||
            book.category === activeCategory;

        const query = searchTerm.trim().toLowerCase();

        const matchesSearch =
            !query ||
            book.title.toLowerCase().includes(query) ||
            book.author.toLowerCase().includes(query) ||
            book.category.toLowerCase().includes(query);

        return matchesCategory && matchesSearch;
    });

    sections.forEach(section => {
        const sectionBooks = filteredBooks.filter(book =>
            section.category === "الكل"
                ? true
                : book.category === section.category
        );

        if (!sectionBooks.length) return;

        const sectionElement = document.createElement("section");
        sectionElement.className = "section";

        sectionElement.innerHTML = `
            <div class="section-heading">
                <h2 class="section-title">
                    <span class="material-icons-round">
                        ${escapeHTML(section.icon)}
                    </span>
                    ${escapeHTML(section.title)}
                </h2>

                <button class="see-all"
                        data-show-category="${escapeHTML(section.category)}">
                    ‹ عرض الكل
                </button>
            </div>

            <div class="books-row">
                ${sectionBooks.map(book => `
                    <article class="book-card"
                             tabindex="0"
                             role="button"
                             data-book="${escapeHTML(book.title)}"
                             aria-label="عرض ${escapeHTML(book.title)}">

                        <img class="book-cover"
                             src="${escapeHTML(book.cover)}"
                             alt="غلاف ${escapeHTML(book.title)}"
                             loading="lazy"
                             onerror="this.onerror=null;this.src='https://placehold.co/300x420/eaf4ff/0d3b66?text=Book';">

                        <h3 class="book-title">
                            ${escapeHTML(book.title)}
                        </h3>

                        <p class="book-author">
                            ${escapeHTML(book.author)}
                        </p>

                        <span class="book-category">
                            ${escapeHTML(book.category)}
                        </span>

                        <div class="book-rating">
                            <span class="star">★</span>
                            ${escapeHTML(book.rating)}
                        </div>
                    </article>
                `).join("")}
            </div>
        `;

        sectionsContainer.appendChild(sectionElement);
    });

    if (!sectionsContainer.children.length) {
        sectionsContainer.innerHTML = `
            <p style="text-align:center;padding:40px 15px">
                لم نعثر على كتب تطابق بحثك.
            </p>
        `;
    }
}

function openBook(title) {
    const book = books.find(item => item.title === title);
    if (!book) return;

    modalContent.innerHTML = `
        <h2>${escapeHTML(book.title)}</h2>

        <img class="modal-cover"
             src="${escapeHTML(book.cover)}"
             alt="غلاف الكتاب"
             onerror="this.onerror=null;this.src='https://placehold.co/300x420/eaf4ff/0d3b66?text=Book';">

        <p><strong>المؤلف:</strong>
           ${escapeHTML(book.author)}</p>

        <p><strong>القسم:</strong>
           ${escapeHTML(book.category)}</p>

        <p>${escapeHTML(book.description)}</p>

        <button class="action-btn" id="readButton">
            قراءة الكتاب
        </button>

        <button class="action-btn secondary" id="downloadButton">
            تحميل PDF
        </button>

        <button class="action-btn secondary" id="favoriteButton">
            ♡ إضافة إلى مكتبتي
        </button>

        <p id="bookMessage" aria-live="polite"></p>
    `;

    bookModal.classList.add("show");

    document.getElementById("readButton").onclick = () => {
        document.getElementById("bookMessage").textContent =
            "ستتوفر القراءة بعد ربط ملف الكتاب الحقيقي.";
    };

    document.getElementById("downloadButton").onclick = () => {
        document.getElementById("bookMessage").textContent =
            "ستتوفر خاصية التحميل بعد إضافة رابط PDF حقيقي.";
    };

    document.getElementById("favoriteButton").onclick = () => {
        let favorites = JSON.parse(
            localStorage.getItem("maktabatiFavorites") || "[]"
        );

        if (favorites.includes(book.title)) {
            document.getElementById("bookMessage").textContent =
                "الكتاب موجود بالفعل في مكتبتي.";
            return;
        }

        favorites.push(book.title);

        localStorage.setItem(
            "maktabatiFavorites",
            JSON.stringify(favorites)
        );

        document.getElementById("bookMessage").textContent =
            "أُضيف الكتاب إلى مكتبتك على هذا الجهاز.";
    };
}

/* فتح الكتب */

sectionsContainer.addEventListener("click", event => {
    const card = event.target.closest("[data-book]");
    const showCategory = event.target.closest("[data-show-category]");

    if (card) {
        openBook(card.dataset.book);
    }

    if (showCategory) {
        selectCategory(showCategory.dataset.showCategory);
        document.getElementById("categories").scrollIntoView({
            behavior: "smooth",
            block: "start"
        });
    }
});

sectionsContainer.addEventListener("keydown", event => {
    if (event.key !== "Enter" && event.key !== " ") return;

    const card = event.target.closest("[data-book]");
    if (card) {
        event.preventDefault();
        openBook(card.dataset.book);
    }
});

/* البحث */

searchInput.addEventListener("input", () => {
    searchTerm = searchInput.value;
    renderBooks();
});

/* اختيار التصنيف */

function selectCategory(category) {
    activeCategory = category;

    document.querySelectorAll(".category").forEach(button => {
        button.classList.toggle(
            "active",
            button.dataset.category === category
        );
    });

    renderBooks();
}

document.querySelectorAll(".category").forEach(button => {
    button.addEventListener("click", () => {
        selectCategory(button.dataset.category);
    });
});

/* الوضع الليلي */

document.getElementById("themeButton").addEventListener("click", () => {
    document.body.classList.toggle("dark");

    const dark = document.body.classList.contains("dark");

    document.getElementById("themeButton").innerHTML =
        `<span class="material-icons-round">${
            dark ? "light_mode" : "dark_mode"
        }</span>`;

    localStorage.setItem("maktabatiDark", dark ? "1" : "0");
});

if (localStorage.getItem("maktabatiDark") === "1") {
    document.body.classList.add("dark");

    document.getElementById("themeButton").innerHTML =
        '<span class="material-icons-round">light_mode</span>';
}

/* القائمة الجانبية */

const drawer = document.getElementById("drawer");
const overlay = document.getElementById("overlay");

function closeDrawer() {
    drawer.classList.remove("open");
    overlay.classList.remove("show");
}

document.getElementById("menuButton").onclick = () => {
    drawer.classList.add("open");
    overlay.classList.add("show");
};

document.getElementById("closeDrawer").onclick = closeDrawer;
overlay.onclick = closeDrawer;

/* إغلاق نافذة الكتاب */

document.getElementById("closeModal").onclick = () => {
    bookModal.classList.remove("show");
};

bookModal.addEventListener("click", event => {
    if (event.target === bookModal) {
        bookModal.classList.remove("show");
    }
});

/* المشاركة */

document.getElementById("shareButton").onclick = async () => {
    const shareData = {
        title: "مكتبتي",
        text: "اكتشف عالم الكتب مع مكتبتي",
        url: location.href
    };

    try {
        if (navigator.share) {
            await navigator.share(shareData);
        } else if (navigator.clipboard) {
            await navigator.clipboard.writeText(location.href);
            alert("تم نسخ رابط الصفحة.");
        } else {
            alert("بعد نشر الموقع، يمكنك مشاركة رابطه مع الآخرين.");
        }
    } catch (error) {
        if (error.name !== "AbortError") {
            alert("تعذرت المشاركة من هذا المتصفح.");
        }
    }
};

/* أزرار التنقل */

function navigate(page) {
    closeDrawer();

    document.querySelectorAll(".nav-item").forEach(button => {
        button.classList.toggle(
            "active",
            button.dataset.page === page
        );
    });

    if (page === "home") {
        activeCategory = "الكل";
        searchInput.value = "";
        searchTerm = "";
        selectCategory("الكل");

        window.scrollTo({ top: 0, behavior: "smooth" });
        return;
    }

    if (page === "categories") {
        document.getElementById("categories").scrollIntoView({
            behavior: "smooth"
        });
        return;
    }

    if (page === "library") {
        const favorites = JSON.parse(
            localStorage.getItem("maktabatiFavorites") || "[]"
        );

        alert(
            favorites.length
                ? "كتبك المحفوظة:\n" + favorites.join("\n")
                : "لم تضف أي كتاب إلى مكتبتك بعد."
        );
        return;
    }

    if (page === "notifications") {
        alert("لا توجد إشعارات جديدة.");
        return;
    }

    if (page === "profile") {
        alert("سيُضاف الملف الشخصي عند تطوير الموقع.");
    }
}

document.querySelectorAll("[data-page]").forEach(button => {
    button.addEventListener("click", () => {
        navigate(button.dataset.page);
    });
});

/* عرض الصفحة الرئيسية */

renderBooks();
</script>

