    <div class="feature">
        <span class="material-icons-round">verified_user</span>
        <div>
            <strong>تجربة قراءة مريحة</strong>
            <small>واجهة سهلة الاستخدام</small>
        </div>
    </div>

    <div class="feature">
        <span class="material-icons-round">devices</span>
        <div>
            <strong>متوافق مع الأجهزة</strong>
            <small>هاتف وحاسوب ولوحي</small>
        </div>
    </div>

    <div class="feature">
        <span class="material-icons-round">favorite</span>
        <div>
            <strong>اكتشف عالمًا جديدًا</strong>
            <small>مع مكتبتي</small>
        </div>
    </div>

</section>

<!-- القائمة السفلية -->
<nav class="bottom-nav">

    <button class="nav-item active" data-page="home">
        <span class="material-icons-round">home</span>
        الرئيسية
    </button>

    <button class="nav-item" data-page="categories">
        <span class="material-icons-round">grid_view</span>
        الأقسام
    </button>

    <button class="nav-item" data-page="library">
        <span class="material-icons-round">auto_stories</span>
        مكتبتي
    </button>

    <button class="nav-item" data-page="notifications">
        <span class="material-icons-round">notifications_none</span>
        الإشعارات
    </button>

    <button class="nav-item" data-page="profile">
        <span class="material-icons-round">person_outline</span>
        الملف الشخصي
    </button>

