    .nav-item {
        flex: 0 1 110px;
    }
}
</style>
</head>

<body>

<header class="header">
    <div class="header-row">

        <button class="icon-btn" id="menuButton"
                aria-label="فتح القائمة">
            <span class="material-icons-round">menu</span>
