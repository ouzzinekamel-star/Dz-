<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0866cc">
<title>مكتبتي | اقرأ لتتغير حياتك</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">

<style>
:root {
    --blue: #0866cc;
    --dark-blue: #0d3b66;
    --light-blue: #eaf4ff;
    --bg: #f7fbff;
    --card: #ffffff;
    --text: #153d70;
    --muted: #7187a5;
    --border: #e8eff8;
    --shadow: 0 3px 12px rgba(23, 67, 115, .08);
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Cairo', sans-serif;
    background: var(--bg);
    color: var(--text);
    padding-bottom: 85px;
}

button, input {
    font: inherit;
}

button {
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
}

button:focus-visible,
input:focus-visible {
    outline: 2px solid #54a6ff;
    outline-offset: 2px;
}

/* رأس الصفحة */

.header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: linear-gradient(110deg, #0755b6, #087ce9);
    color: white;
    padding: 12px 14px;
    box-shadow: 0 3px 12px #063f831c;
}

.header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 9px;
}

.icon-btn {
    width: 37px;
    height: 40px;
    flex-shrink: 0;
    border: 0;
    color: white;
    background: transparent;
    display: grid;
    place-items: center;
    border-radius: 10px;
}

.icon-btn:active {
    background: #ffffff25;
}

.material-icons-round {
    font-size: 25px;
}

.search-box {
    display: flex;
    align-items: center;
    flex: 1;
    min-width: 70px;
    height: 43px;
    background: #ffffff24;
    border-radius: 25px;
    padding: 0 10px;
}

.search-box input {
    min-width: 0;
    width: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    color: white;
    font-size: 12px;
}

.search-box input::placeholder {
    color: #ffffffbd;
}

.logo {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
}

.logo .material-icons-round {
    font-size: 35px;
}

.logo-text {
    font-size: 19px;
    font-weight: 800;
    line-height: 1.25;
}

.logo small {
    display: block;
    font-size: 9px;
    font-weight: 400;
    text-align: center;
}

/* القائمة الجانبية */

.overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 40;
    background: #0007;
}

.overlay.show {
    display: block;
}

.drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 41;
    width: min(290px, 85vw);
    padding: 24px 18px;
    background: var(--card);
    transform: translateX(110%);
    transition: transform .25s;
    box-shadow: -5px 0 20px #0001;
}

.drawer.open {
    transform: translateX(0);
}

.drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--blue);
    font-size: 22px;
    font-weight: 800;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
}

.drawer button {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    margin-top: 10px;
    padding: 12px;
    color: var(--text);
    border: 0;
    border-radius: 12px;
    background: transparent;
    text-align: right;
}

.drawer button:hover {
    background: var(--light-blue);
}

/* الإعلان */

.ad-banner {
    position: relative;
    min-height: 150px;
    margin: 14px 12px 16px;
    border-radius: 15px;
    overflow: hidden;
    background:
      linear-gradient(90deg, #062b4c88, #064a88a8),
      url('https://images.unsplash.com/photo-1507842217343-583bb7270b66?auto=format&fit=crop&w=1100&q=80')
      center/cover;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
}

.ad-content {
    padding: 22px 12px;
}

.ad-content h1 {
    font-size: clamp(21px, 5vw, 29px);
    font-weight: 800;
}

.ad-content p {
    font-size: 14px;
    margin-top: 3px;
}

.ad-label {
    position: absolute;
    top: 9px;
    right: 9px;
    background: #0874e8;
    color: white;
    padding: 3px 10px;
    border-radius: 7px;
    font-size: 11px;
}

.ad-dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 12px;
}

.ad-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ffffff80;
}

.ad-dots span:first-child {
    background: white;
}

/* التصنيفات */

.categories {
    display: flex;
    gap: 9px;
    overflow-x: auto;
    padding: 0 12px 9px;
    scrollbar-width: none;
}

.categories::-webkit-scrollbar,
.books-row::-webkit-scrollbar {
    display: none;
}

.category {
    flex: 0 0 82px;
    min-height: 93px;
    border: 1px solid transparent;
    border-radius: 14px;
    background: #edf5ff;
    color: var(--dark-blue);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    font-weight: 700;
    padding: 8px 3px;
}

.category .material-icons-round {
    font-size: 28px;
    color: #0758b8;
}

.category.active {
    border-color: #8dbfff;
    background: #d8eaff;
}

/* عناوين الأقسام */

.section {
    margin-top: 20px;
}

.section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 15px;
    margin-bottom: 10px;
}

.section-title {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 20px;
    font-weight: 800;
    color: var(--dark-blue);
}

.section-title .material-icons-round {
    color: var(--blue);
    font-size: 27px;
}

.see-all {
    border: 0;
    background: transparent;
    color: var(--blue);
    font-size: 13px;
    font-weight: 700;
}

/* بطاقات الكتب */

.books-row {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding: 3px 12px 10px;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
}

.book-card {
    flex: 0 0 155px;
    min-width: 0;
    padding: 8px;
    border-radius: 13px;
    background: var(--card);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    text-align: center;
    scroll-snap-align: start;
    cursor: pointer;
    transition: transform .2s;
}

.book-card:active {
    transform: scale(.97);
}

.book-cover {
    width: 100%;
    height: 164px;
    object-fit: cover;
    border-radius: 7px;
    background: var(--light-blue);
    display: block;
}

.book-title {
    font-size: 12px;
    font-weight: 800;
    line-height: 1.7;
    margin-top: 6px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.book-author {
    color: var(--muted);
    font-size: 11px;
    margin-top: 2px;
}

.book-category {
    display: inline-block;
    margin-top: 6px;
    background: var(--light-blue);
    color: var(--blue);
    border-radius: 20px;
    padding: 2px 9px;
    font-size: 10px;
}

.book-rating {
    margin-top: 6px;
    color: var(--text);
    font-size: 12px;
    direction: ltr;
}

.star {
    color: #ffad21;
}

/* مزايا الموقع */

.features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin: 20px 12px;
}

.feature {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px;
    background: var(--light-blue);
    border-radius: 13px;
}

.feature .material-icons-round {
    font-size: 27px;
    color: var(--blue);
}

.feature strong {
    display: block;
    font-size: 12px;
}

.feature small {
    display: block;
    font-size: 10px;
    color: var(--muted);
}

/* الشريط السفلي */

.bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 25;
    display: flex;
    justify-content: space-around;
    align-items: center;
    min-height: 73px;
    padding: 6px 2px calc(6px + env(safe-area-inset-bottom));
    background: var(--card);
    border-top: 1px solid var(--border);
    box-shadow: 0 -3px 15px #173e6610;
}

.nav-item {
    flex: 1;
    border: 0;
    background: transparent;
    color: var(--muted);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    font-size: 10px;
    font-weight: 700;
    min-width: 0;
}

.nav-item .material-icons-round {
    font-size: 24px;
}

.nav-item.active {
    color: var(--blue);
}

/* نافذة تفاصيل الكتاب */

.modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 60;
    background: #0008;
    align-items: center;
    justify-content: center;
    padding: 18px;
}

.modal.show {
    display: flex;
}

.modal-card {
    width: 100%;
    max-width: 420px;
    max-height: 85vh;
    overflow-y: auto;
    padding: 20px;
    border-radius: 18px;
    background: var(--card);
    color: var(--text);
    text-align: center;
}

.modal-cover {
    width: 135px;
    height: 175px;
    object-fit: cover;
    border-radius: 8px;
    margin: 12px auto;
}

.modal-card h2 {
    font-size: 20px;
}

.modal-card p {
    font-size: 13px;
    line-height: 1.9;
    color: var(--muted);
    margin: 8px 0;
}

.action-btn {
    display: block;
    width: 100%;
    padding: 11px;
    margin-top: 9px;
    border: 0;
    border-radius: 10px;
    background: var(--blue);
    color: white;
    font-weight: 700;
}

.action-btn.secondary {
    background: var(--light-blue);
    color: var(--blue);
}

.close-btn {
    float: left;
    border: 0;
    background: transparent;
    color: var(--text);
}

/* الوضع الليلي */

body.dark {
    --bg: #0c1522;
    --card: #142236;
    --text: #e3edfc;
    --dark-blue: #d6e8ff;
    --light-blue: #1d3450;
    --muted: #a2b4cd;
    --border: #263951;
    --shadow: 0 3px 12px #0002;
}

body.dark .category {
    background: #1d3450;
    color: #d6e8ff;
}

body.dark .category.active {
    background: #24476e;
}

@media (min-width: 700px) {
    .header {
        padding: 14px 5%;
    }

    .ad-banner {
        margin: 20px auto;
        max-width: 1100px;
        min-height: 230px;
    }

    .categories {
        justify-content: center;
        flex-wrap: wrap;
    }

    .category {
        flex-basis: 105px;
    }

    .section {
        max-width: 1200px;
        margin: 25px auto 0;
    }

    .book-card {
        flex-basis: 185px;
    }

    .book-cover {
        height: 220px;
    }

    .features {
        max-width: 1000px;
        margin: 25px auto;
        grid-template-columns: repeat(4, 1fr);
    }

    .bottom-nav {
        justify-content: center;
        gap: 30px;
    }

    .nav-item {
        flex: 0 1 110px;
    }
}
</style>
</head>

